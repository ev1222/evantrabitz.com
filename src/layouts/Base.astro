---
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { AUTHOR, CF_ANALYTICS_TOKEN } from '../consts';

type Props = HeadProps & {
	/** Hide the name link at the top (the homepage already leads with it). */
	bare?: boolean;
};

const { bare = false, ...head } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Apply a stored theme choice before first paint (no flash of the wrong theme). -->
		<script is:inline>
			try {
				const t = localStorage.getItem('theme');
				if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
			} catch {}
		</script>
		<BaseHead {...head} />
		<slot name="head" />
	</head>
	<body>
		<ThemeToggle />
		{
			!bare && (
				<header class="site-header">
					<a href="/">{AUTHOR}</a>
				</header>
			)
		}
		<main>
			<slot />
		</main>
		{
			import.meta.env.PROD && CF_ANALYTICS_TOKEN && (
				<script
					is:inline
					defer
					src="https://static.cloudflareinsights.com/beacon.min.js"
					data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}
				/>
			)
		}
	</body>
</html>
