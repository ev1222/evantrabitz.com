---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import FormattedDate from '../components/FormattedDate.astro';
import { AUTHOR, CONTACT, SITE_DESCRIPTION } from '../consts';
import Base from '../layouts/Base.astro';
import { getPosts, postUrl } from '../lib/posts';

const posts = await getPosts();
const sections = [
	{ heading: 'Essays', posts: posts.filter((p) => p.data.kind === 'essay') },
	{ heading: 'Notes', posts: posts.filter((p) => p.data.kind === 'note') },
].filter((s) => s.posts.length > 0);

// public/resume.pdf is committed by a GitHub Action in the private resume repo.
const hasResume = existsSync(join(process.cwd(), 'public', 'resume.pdf'));

const links = [
	CONTACT.email && { label: 'Email', href: `mailto:${CONTACT.email}` },
	CONTACT.github && { label: 'GitHub', href: CONTACT.github },
	CONTACT.linkedin && { label: 'LinkedIn', href: CONTACT.linkedin },
	hasResume && { label: 'Resume', href: '/resume.pdf' },
	{ label: 'RSS', href: '/rss.xml' },
].filter((l): l is { label: string; href: string } => Boolean(l));
---

<Base description={SITE_DESCRIPTION} bare>
	<h1 class="name">{AUTHOR}</h1>

	<section class="bio">
		<p>
			I'm an AI Engineer at <a href="https://bwe.com/">BWE</a> building models and running evals, with additional interests in physics, philosophy, economics, finance, and more.
			<br><br>
			Here you can learn more about me and read what's on my mind. Essays are longer-form pieces, notes are shorter, more informal thoughts.
		</p>
		<p class="links">
			{CONTACT.location && <span>{CONTACT.location}</span>}
			{links.map((l) => <a href={l.href}>{l.label}</a>)}
		</p>
	</section>

	{
		sections.map((s) => (
			<section class="index">
				<h2>{s.heading}</h2>
				<ul>
					{s.posts.map((p) => (
						<li>
							<a href={postUrl(p.id)}>{p.data.title}</a>
							<FormattedDate date={p.data.pubDate} />
						</li>
					))}
				</ul>
			</section>
		))
	}
</Base>
